    },
    "expected": "name=Zo%C3%AB%20%E6%9D%B1%E4%BA%AC"
  },
  {
    "name": "empty string",
    "input": {
      "name": ""
    },
    "expected": "name="
  },
  {
    "name": "null is empty",
    "input": {
      "name": null
    },
    "expected": "name="
  },
  {
    "name": "nested object",
    "input": {
      "filter": {
        "status": "open",
        "owner": {
          "id": "u1"
        }
      }
    },
    "expected": "filter%5Bowner%5D%5Bid%5D=u1&filter%5Bstatus%5D=open"
  },
  {
    "name": "array of strings",
    "input": {
      "ids": [
        "a",
        "b",
        "c"
      ]
    },
    "expected": "ids%5B0%5D=a&ids%5B1%5D=b&ids%5B2%5D=c"
  },
  {
    "name": "array of numbers",
    "input": {
      "n": [
        1,
        2
      ]
    },
    "expected": "n%5B0%5D=1&n%5B1%5D=2"
  },
  {
    "name": "array of objects",
    "input": {
      "sort": [
        {
          "field": "name",
          "dir": "asc"
        },
        {
          "field": "id",
          "dir": "desc"
        }
      ]
    },
    "expected": "sort%5B0%5D%5Bdir%5D=asc&sort%5B0%5D%5Bfield%5D=name&sort%5B1%5D%5Bdir%5D=desc&sort%5B1%5D%5Bfield%5D=id"
  },
  {
    "name": "nested array in object",
    "input": {
      "filter": {
        "tags": [
          "x",
          "y"
        ]
      }
    },
    "expected": "filter%5Btags%5D%5B0%5D=x&filter%5Btags%5D%5B1%5D=y"
  },
  {
    "name": "empty array skipped",
    "input": {
      "ids": [],
      "keep": "k"
