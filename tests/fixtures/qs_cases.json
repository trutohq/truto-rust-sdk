    "expected": "keep=k"
  },
  {
    "name": "empty object skipped",
    "input": {
      "filter": {},
      "keep": "k"
    },
    "expected": "keep=k"
  },
  {
    "name": "truto admin filter",
    "input": {
      "integration": {
