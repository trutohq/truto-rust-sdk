[
  {
    "name": "empty",
    "input": {},
    "expected": ""
  },
  {
    "name": "single string",
    "input": {
      "integrated_account_id": "abc-123"
    },
    "expected": "integrated_account_id=abc-123"
  },
  {
    "name": "number and bool",
    "input": {
      "limit": 50,
      "truncate": true,
      "archived": false
    },
    "expected": "archived=false&limit=50&truncate=true"
  },
  {
    "name": "float",
    "input": {
      "ratio": 1.5
    },
    "expected": "ratio=1.5"
  },
  {
    "name": "keys are sorted",
    "input": {
      "zeta": "1",
      "alpha": "2",
      "mid": "3"
    },
    "expected": "alpha=2&mid=3&zeta=1"
  },
  {
    "name": "space and symbols",
    "input": {
      "q": "hello world & more=yes"
    },
    "expected": "q=hello%20world%20%26%20more%3Dyes"
  },
  {
    "name": "reserved chars",
    "input": {
      "q": "a+b/c?d#e!f'g(h)i*j~k_l-m.n"
    },
    "expected": "q=a%2Bb%2Fc%3Fd%23e%21f%27g%28h%29i%2Aj~k_l-m.n"
  },
  {
    "name": "unicode",
    "input": {
