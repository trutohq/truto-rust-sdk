    "expected": "created_at%5Bgt%5D=2026-01-01T00%3A00%3A00.000Z&integration%5Bname%5D%5B%24in%5D%5B0%5D=hubspot&integration%5Bname%5D%5B%24in%5D%5B1%5D=salesforce"
  },
  {
    "name": "unified api params",
    "input": {
